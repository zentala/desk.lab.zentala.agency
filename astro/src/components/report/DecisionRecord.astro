---
const { number, title, context, considered, rejected, why, decision, tradeoff, mitigation } = Astro.props;
---
<article class="my-8 rounded-2xl border border-report-divider bg-report-surface p-6 sm:p-8"><div class="flex items-center gap-3"><span class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-green">Decision {number}</span><h3 class="text-xl text-gray-100">{title}</h3></div><dl class="mt-7 grid gap-x-8 gap-y-5 text-sm leading-6 sm:grid-cols-2"><div><dt class="font-semibold text-gray-300">Context</dt><dd class="mt-1 text-muted">{context}</dd></div><div><dt class="font-semibold text-gray-300">Considered</dt><dd class="mt-1 text-muted">{considered}</dd></div><div><dt class="font-semibold text-gray-300">Rejected</dt><dd class="mt-1 text-muted">{rejected}</dd></div><div><dt class="font-semibold text-gray-300">Why</dt><dd class="mt-1 text-muted">{why}</dd></div><div class="sm:col-span-2"><dt class="font-semibold text-brand-green">Decision</dt><dd class="mt-1 text-gray-200">{decision}</dd></div><div><dt class="font-semibold text-gray-300">Trade-off</dt><dd class="mt-1 text-muted">{tradeoff}</dd></div><div><dt class="font-semibold text-gray-300">Mitigation</dt><dd class="mt-1 text-muted">{mitigation}</dd></div></dl></article>
