---
import Icon from '../ui/Icon';
import StatusPill from './StatusPill.astro';
import { workstreams } from '../../data/project-status';
const icons = ['app', 'board', 'enclosure'];
---
<section id="current" class="report-container py-16 md:py-20">
  <div class="mb-10"><p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-brand-green">Current work</p><h2 class="text-3xl text-gray-100 md:text-4xl">What exists now</h2></div>
  <div class="divide-y divide-report-divider border-y border-report-divider">
    {workstreams.map((item, index) => <article class="grid gap-5 py-7 md:grid-cols-[2fr_3fr_2fr] md:gap-8">
      <div class="flex gap-4"><div class="mt-1 text-brand-green"><Icon name={icons[index]} size={22} /></div><div><h3 class="text-xl text-gray-100">{item.name}</h3><div class="mt-3"><StatusPill state={item.state} /></div></div></div>
      <div><p class="leading-7 text-gray-300">{item.summary}</p><p class="mt-4 text-sm leading-6 text-muted"><span class="font-semibold text-gray-400">Evidence: </span>{item.evidence.href ? <a class="report-link" href={item.evidence.href}>{item.evidence.label}</a> : null} {item.evidence.note}</p></div>
      <div class="text-sm leading-6 text-muted"><p class="mb-2 flex items-center gap-2 font-semibold text-gray-300"><Icon name="next" size={16} /> Next milestone</p><p>{item.next}</p><time class="mt-4 block text-xs uppercase tracking-wider" datetime={item.updatedAt}>Updated {item.updatedAt}</time></div>
    </article>)}
  </div>
</section>
